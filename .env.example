NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
DATABASE_URL=postgresql://northstar:northstar@localhost:5432/northstar?schema=public
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=northstar-local
S3_ACCESS_KEY=northstar
S3_SECRET_KEY=northstar-local-secret
MAIL_HOST=localhost
MAIL_PORT=1025
MAILPIT_API_URL=http://localhost:8025/api/v1/send
EMAIL_FROM=Northstar <no-reply@example.com>
# Production account email delivery uses the Resend API.
RESEND_API_KEY=
SESSION_SECRET=replace-with-at-least-32-random-characters
MFA_ENCRYPTION_KEY=replace-with-a-separate-random-secret-at-least-32-characters
WEBHOOK_ENCRYPTION_KEY=replace-with-another-separate-random-secret-at-least-32-characters
LOCAL_AI_SEED=northstar-demo
AI_PROVIDER=local
BILLING_PROVIDER=local
ASSESSMENT_PROCESSING_MODE=inline
WORKER_CONCURRENCY=4
WEBHOOK_CONCURRENCY=8
EPHEMERAL_RETENTION_GRACE_DAYS=30
# Optional private monitoring endpoint; generate a separate random token (at least 32 characters).
METRICS_TOKEN=
# Nova invitation-result encryption, separate from model credentials; keep stable across restarts.
NOVA_RESULT_ENCRYPTION_KEY=
# Nova stays disabled unless all model settings below are explicitly configured.
# Protocol: responses or chat-completions. Choose your provider/model before use.
NOVA_PROVIDER=
NOVA_BASE_URL=
NOVA_MODEL=
NOVA_API_KEY=
# Optional explicit loopback-only Ollama chat profile; leave blank for other providers.
NOVA_COMPATIBILITY=

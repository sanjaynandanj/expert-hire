global:
  scrape_interval: 15s

rule_files:
  - /etc/prometheus/alerts.yml

scrape_configs:
  - job_name: northstar-api
    metrics_path: /metrics
    authorization:
      credentials_file: /run/secrets/api_metrics_token
    static_configs:
      - targets: ["api:4000"]
  - job_name: northstar-worker
    metrics_path: /metrics
    authorization:
      credentials_file: /run/secrets/worker_metrics_token
    static_configs:
      - targets: ["worker:4001"]

  },
  "dependencies": {
    "@northstar/database": "workspace:*",
    "@northstar/providers": "workspace:*",
    "bullmq": "6.3.11",
    "ioredis": "6.0.0"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
